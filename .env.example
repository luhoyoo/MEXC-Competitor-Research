VISION_PROVIDER=minimax
MINIMAX_API_KEY=your-minimax-key-here
MINIMAX_VISION_TIMEOUT=120

# 可选：如果以后想切回 OpenAI，再把 VISION_PROVIDER 改成 openai，并填写下面两项。
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# 飞书/Lark 群机器人 Webhook（用于每日日报推群）
# 在飞书群里：设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook 地址
LARK_GROUP_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your-bot-token
# 可选：如果你在群机器人里勾选了"签名校验"，把生成的密钥填到这里，否则留空
LARK_GROUP_WEBHOOK_SECRET=

# --- 视觉分析（旧图片抓取流程使用，新流程不依赖）---
VISION_PROVIDER=minimax
MINIMAX_API_KEY=your-minimax-key-here
MINIMAX_VISION_TIMEOUT=120

# --- 云端研究 agent（云端工作流和本地手跑都用）---
# 申请：https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
# 视觉分析备用模型（旧流程使用）
OPENAI_VISION_MODEL=gpt-4.1-mini

# --- Lark 群机器人 Webhook（推 TL;DR 卡片到群）---
# 飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook 地址
LARK_GROUP_WEBHOOK=https://open.larksuite.com/open-apis/bot/v2/hook/your-bot-token
# 可选：勾了"签名校验"才填密钥
LARK_GROUP_WEBHOOK_SECRET=
